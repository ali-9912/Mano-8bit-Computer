//8 bit ALU
module ALU(AC,X,S,W,E);
  input [7:0] AC,X ;
  input [2:0] S ;
  output reg [7:0] W ;
  output reg E ;
  
  wire M0,K1,K0,N1 ;
  wire [7:0] Q,L,B ;
  assign M0=(~(S[0]|S[1]|S[2]))| S[1] ;
  assign K1= ~(S[0]|S[1]|S[2]) ;
  assign K0=S[0]&S[1] ;
  assign N1=S[2]&S[0] ;
  
  fulladder8it  a1(Q,E,AC,X,);
  logicunit8bit a2(AC,X,K1,K0,L);
  shiftregister a3(B,AC,N1,S[2],E,E,);
  Mux3to1 a4(Q,L,B,S[2],M0);
  
endmodule 