module Encoder8to3(I0,I1,I2,I3,I4,I5,I6,I7,Q0,Q1,Q2);
 input I0,I1,I2,I3,I4,I5,I6,I7 ;
 output Q0,Q1,Q2 ;
 wire m0,m1,m2,m3,m4,m5,m6 ;
 
 assign m0= ~I0&I1;
 assign m1= ~I0&~I1&I2;
 assign m2= ~I0&~I1&~I2&I3;
 assign m3= ~I0&~I1&~I2&~I3&I4;
 assign m4= ~I0&~I1&~I2&~I3&~I4&I5;
 assign m5= ~I0&~I1&~I2&~I3&~I4&~I5&I6;
 assign m6= ~I0&~I1&~I2&~I3&~I4&~I5&~I6&I7;
 
 assign Q0= m0|m2|m4|m6 ;
 assign Q1= m1|m2|m5|m6 ;
 assign Q2= m3|m4|m5|m6 ;
  
endmodule
