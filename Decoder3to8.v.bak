module Decoder3to8(I,T);
 input [2:0] I ;
 output [7:0] T ;
 wire I0b,I1b,I2b ;
 
 not n0(I0b,I[0]);
 not n1(I1b,I[1]);
 not n2(I2b,I[2]);
 and m0(T[0],I2b,I1b,I0b);
 and m1(T[1],I2b,I1b,I[0]);
 and m2(T[2],I2b,I[1],I0b);
 and m3(T[3],I2b,I[1],I[0]);
 and m4(T[4],I[2],I1b,I0b);
 and m5(T[5],I[2],I1b,I[0]);
 and m6(T[6],I[2],I[1],I0b);
 and m7(T[7],I[2],I[1],I[0]);
 
endmodule