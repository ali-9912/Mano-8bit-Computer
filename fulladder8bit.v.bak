//8 bit Fulladder
module adder4bit (Sum ,E,AC , X , C_in );
	input  [7:0] AC,X;
	input  C_in;
	output [7:0] Sum;
	output E;	
	
	wire C1,C2,C3,C4,C5,C6,C7;
	
	fulladder bit0 (Sum[0], C1,    AC[0], X[0],C_in);
	fulladder bit1 (Sum[1], C2,    AC[1], X[1],C1  );
	fulladder bit2 (Sum[2], C3,	 AC[2], X[2],C2  );
	fulladder bit3 (Sum[3], C4,    AC[3], X[3],C3  );
	fulladder bit4 (Sum[4], C5,    AC[4], X[4],C4  );
	fulladder bit5 (Sum[5], C6,    AC[5], X[5],C5  );
	fulladder bit6 (Sum[6], C7,    AC[6], X[6],C6  );
	fulladder bit7 (Sum[7], E ,    AC[7], X[7],C7  );
endmodule 