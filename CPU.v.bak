module CPU(Clock,Reset,INP,OUT);
  input Clock,Reset ;
  input [7:0] INP ;
  output [7:0] OUT ;
  
  wire [2:0] opcod ;
  wire i,r,e,fgi,fgo,pcld,pcinr,pccl,arld,arinr,arcl,drld,drinr,acld,acinr,
       accl,darld,irld,trld,alus2,alus1,alus0,datard,datawr,instrd,instwr,select ;
  wire [7:0] addressbuspin ;
  wire [1:0] databuspin ;
  wire [7:0] acout ;
  wire [7:0] drout,drin,darin,darout,datamemin,datamemout,W ;
  wire [9:0] instr ;
  wire [9:0] pcin,pcout,arin,arout,trin,trout;
  wire [13:0] irin,instmemin,instmemout ;
  
  assign W= select ? INP : drin ;
  
  Controlunit ins1(.Clock(Clock),.Reset(Reset),.Opcode(opcod),.Inst(instr),.I(i),.R(r),.E(),
                   .FGI(fgi),.FGO(fgo),.AC(acout),.DR(drout),.AddressBusPin(addressbuspin),
						 .DataBusPin(databuspin),.PCload(pcld),.PCincr(pcinr),.PCclear(pccl),
						 .ARload(arld),.ARincr(arinr),.ARclear(arcl),.DRload(drld),.DRincr(drinr),
						 .ACload(acld),.ACincr(acinr),.ACclear(accl),.DARload(darld),.IRload(irld),
						 .TRload(trld),.ALUS2(alus2),.ALUS1(alus1),.ALUS0(alus0),.DatamemoryRead(datard),
                   .DatamemoryWrite(datawr),.InstructionmemoryRead(instrd),.InstructionmemoryWrite(instwr));
                   
  processor ins2(.Clock(Clock),.Reset(Reset),.PCin(pcin),.ARin(arin),.IRin(irin),
                 .TRin(trin),.ALUin(W),.PCload(pcld),.PCincr(pcinr),.PCclear(pccl),
					  .ARload(arld),.ARincr(arinr),.ARclear(arcl),.ACload(acld),.ACincr(acinr),
					  .ACclear(accl),.IRload(irld),.TRload(trld),.ALUS2(alus2),.ALUS1(alus1),
					  .ALUS0(alus0),.C_in(),.PCout(pcout),.ARout(arout),.ACout(acout),
					  .TRout(trout),.Opcode(opcod),.Inst(instr),.E(e),.I(i));
  
  InstructionMemory ins3(.Reset(Reset),.Address(arout),.Read(instrd),.Write(instwr),
                         .Datain(instmemin),.Clock(Clock),.Dataout(instmemout));
  
  data_memory ins4(.Reset(Reset),.Address(darout),.Read(datard),.Write(datawr),
                   .Datain(datamemin),.Clock(Clock),.Dataout(datamemout));
  
  DAR ins5(.I(darin),.Clock(Clock),.LD(darld),.W(darout));
  
  DR ins6(.I(drin),.Clock(Clock),.LD(drld),.INCR(drinr),.W(drout));
  
  AddressBus ins7(.X(),.AR(),.PC(),.IR(),.TR(),.AC(),.MEM(),.B());
  
  DataBus ins8(.X(),.AC(),.DR(),.B());
  
endmodule

