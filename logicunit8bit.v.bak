//8 bit logic unit 
module logicunit8bit(AC,X,k,W);
  input [7:0] AC ;
  input [7:0] X ;
  input [1:0] k ;
  output reg W ;
  
  logicunit bit0(AC[0],X[0],k,W);
  logicunit bit1(AC[1],X[1],k,W);
  logicunit bit2(AC[2],X[2],k,W);
  logicunit bit3(AC[3],X[3],k,W);
  logicunit bit4(AC[4],X[4],k,W);
  logicunit bit5(AC[5],X[5],k,W);
  logicunit bit6(AC[6],X[6],k,W);
  logicunit bit7(AC[7],X[7],k,W);
endmodule