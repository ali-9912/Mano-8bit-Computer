//1kB 14 bit instruction Memory behavioral description
module instruction_memory(Address,Read,Write,Datain,Clock,Dataout); 
  input [13:0] Datain ;
  input Read,Write,Clock ;
  input [1023:0] Address ;
  output [13:0] Dataout ;
  reg [13:0] Dataout ;
  reg [13:0] mem[0:1023] ;
  
  always @(posedge Clock)
   begin
     if(Read==1) Dataout= mem[Address];
     else if(Write==1) mem[Address]=Datain ;
     else Dataout =14'bz ;
   end
endmodule
